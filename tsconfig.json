{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "NodeNext",       // 🔹 Change from "CommonJS" to "ESNext" for better support
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "allowSyntheticDefaultImports": true, // 🔹 Helps with importing modules properly
    "resolveJsonModule": true,
  },
  // Compile only the server and its scripts (plus everything they import). Stray or stale files under src/
  // (e.g. left in a deploy build cache) can then never break the build.
  "files": [
    "src/index.ts",
    "src/database/runMigration.ts",
    "src/database/recovery.ts",
    "src/database/recoverImages.ts",
    "src/database/mailCheck.ts"
  ],
  "exclude": ["node_modules"]
}