{
  "name": "historyback",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "migrate": "ts-node src/database/runMigration.ts",
    "recovery:sql": "ts-node src/database/recovery.ts generate",
    "db:restore": "ts-node src/database/recovery.ts restore",
    "admin:reset": "ts-node src/database/recovery.ts admin",
    "images:recover": "ts-node src/database/recoverImages.ts",
    "test:recovery": "node --test tests/recovery.test.cjs"
  },
