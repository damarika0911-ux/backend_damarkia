NODE_ENV=production
PORT=3000
# Supabase pooler connection string. Keep this server-side.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DB_SSL=true
JWT_SECRET=
CORS_ORIGINS=https://www.damarika.in,https://damarika.in,https://admin.damarika.in
PUBLIC_API_URL=https://api.damarika.in
CONTACT_EMAIL=support@damarika.in
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
# Set to 1 only when exactly one trusted reverse proxy sits in front of Node.
TRUST_PROXY=0
# Run migrations once during deployment, or set this true on the first boot.
RUN_MIGRATIONS=true
STORAGE_DRIVER=supabase
SUPABASE_URL=https://rvspwpdpbpqklwqjdjvc.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://rvspwpdpbpqklwqjdjvc.supabase.co/auth/v1/.well-known/jwks.json
UPLOAD_DIR=./uploads
# Set these only for STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional, for one-time recovery commands; clear ADMIN_PASSWORD afterwards.
RESTORE_CONFIRM_DATABASE=
ADMIN_EMAIL=
ADMIN_NAME=Damarika Administrator
ADMIN_PASSWORD=
